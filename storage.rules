rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /product-assets/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true
        && request.resource.size < 100 * 1024 * 1024;
    }
    match /private-downloads/{allPaths=**} {
      allow read, write: if false; // Deliver via authenticated Cloud Function after ownership checks.
    }
  }
}